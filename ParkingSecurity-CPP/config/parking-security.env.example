# Environment file for parking-security.service.
#
# Copy this to /etc/parking-security/parking-security.env on the Jetson and
# chmod 600. The systemd unit loads it via `EnvironmentFile=`, so these
# values are injected as env vars when the daemon starts. Keeps secrets out
# of the repo and out of plaintext parking.ini.
#
# Override any of these at will — see src/core/config.cpp for the full list
# of supported PARKING_* vars.

# Full libpq connection string (password included). Overrides the
# [database] connection_string key in parking.ini entirely.
PARKING_DB_URL=host=localhost port=5432 user=parking password=changeme_parking_2025 dbname=parking_security

# Must match CAMERA_API_KEY in the new dashboard's docker-compose (or .env).
PARKING_CAMERA_API_KEY=jetson_cam_key_2025

# Optional. Leave empty unless you move the backend to a different host/port.
# PARKING_BACKEND_URL=http://localhost:8001

# Optional. trace | debug | info | warn | error | critical
# PARKING_LOG_LEVEL=info
